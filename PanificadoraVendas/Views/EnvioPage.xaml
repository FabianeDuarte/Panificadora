<?xml version="1.0" encoding="utf-8" ?>
<ContentPage x:Class="PanificadoraVendas.Views.EnvioPage" xmlns="http://schemas.microsoft.com/dotnet/2021/maui" xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml" xmlns:vm="clr-namespace:PanificadoraVendas.ViewModels" Title="Envio de pedidos">
    <Grid RowDefinitions="Auto,*" Padding="12" RowSpacing="8">
        <VerticalStackLayout Spacing="6">
            <Label Text="{Binding Lote12}" FontAttributes="Bold" />
            <Label Text="{Binding Lote19}" FontAttributes="Bold" />
            <Label Text="{Binding Proximo}" FontSize="12" />
            <Button Text="Enviar pedidos agora" Command="{Binding EnviarCommand}" />
            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label Text="{Binding Status}" FontSize="12" />
        </VerticalStackLayout>
        <CollectionView Grid.Row="1" ItemsSource="{Binding Pedidos}">
            <CollectionView.EmptyView>
                <Label Text="Nenhum pedido registrado." HorizontalTextAlignment="Center" Margin="20" />
            </CollectionView.EmptyView>
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Border Padding="12" Margin="0,0,0,8" Stroke="#BDBDBD" StrokeShape="RoundRectangle 10">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                            <VerticalStackLayout Spacing="2">
                                <Label Text="{Binding ClienteNome}" FontAttributes="Bold" />
                                <Label Text="{Binding DetalheTexto}" FontSize="12" />
                                <Label Text="{Binding StatusTexto}" TextColor="{Binding CorStatus}" FontSize="12" FontAttributes="Bold" />
                            </VerticalStackLayout>
                            <VerticalStackLayout Grid.Column="1" Spacing="4" HorizontalOptions="End">
                                <Label Text="{Binding TotalTexto}" FontAttributes="Bold" HorizontalTextAlignment="End" />
                                <Button Text="Excluir" FontSize="11" HeightRequest="30" Padding="8,0" IsVisible="{Binding Pendente}"
                                        CommandParameter="{Binding .}"
                                        Command="{Binding Source={RelativeSource AncestorType={x:Type vm:EnvioViewModel}}, Path=ExcluirCommand}" />
                            </VerticalStackLayout>
                        </Grid>
                    </Border>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>
    </Grid>
</ContentPage>
